{
  "name": "add-css-rules",
  "version": "1.0.0",
  "type": "module",
  "description": "A utility to dynamically add CSS rules to stylesheets",
  "types": "./dist/add-css-rules.d.ts",
  "exports": {
    ".": {
      "types": "./dist/add-css-rules.d.ts",
      "import": "./dist/add-css-rules.js",
      "default": "./dist/add-css-rules.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch"
  },
  "keywords": [
    "css",
    "stylesheet",
    "dynamic",
    "rules",
    "dom",
    "browser"
  ],
  "author": "Nicholas Andre Burke-Gaffney",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicholasbg/addCSSRules.git"
  },
  "bugs": {
    "url": "https://github.com/nicholasbg/addCSSRules/issues"
  },
  "homepage": "https://github.com/nicholasbg/addCSSRules#readme",
  "devDependencies": {
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "csstype": "^3.2.3",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=26"
  }
}
